# ======================================================================
# WORKER PC .env — Homework Content Generation (worker node)
# ======================================================================
# Copy this to `.env` on a WORKER PC. A worker only claims jobs and runs
# generation — it does NOT serve the SPA/API or host the database (that's the
# single HEAD machine). So this template is intentionally slim: head-only
# settings (CORS, /docs, upload limits, ops tokens) are omitted.
#
# MODEL SELECTION IS NOT HERE. Judge / extract / content / TOC (provider +
# model + transport) and output language are managed in the UI at /settings
# (DB-backed `launch_defaults`) and picked up from the shared database. Do not
# set EXTRACT_*, JUDGE_*, or GEMINI_MODEL — they're dead.
#
# Fill the REQUIRED block. The OPTIONAL knobs already have sane defaults.


# ─── REQUIRED ──────────────────────────────────────────────────────────

# Shared Postgres on the HEAD. Same database every worker + the head connect
# to. Swap <HEAD-LAN-IP> for the head's LAN address (e.g. 192.168.1.124); keep
# the head's DB name (the live fleet uses `edu_copy`). Current head: 192.168.1.124
# — note it's DHCP and can change on reboot; reserve/static-assign it to be safe.
DATABASE_URL=postgresql+asyncpg://edu:edu@<HEAD-LAN-IP>:5432/edu_copy

# Marks this PC as a worker: number of jobs it runs at once. Keep modest per PC
# (2–3) so a single box doesn't monopolise the shared Vertex quota.
WORKER_CONCURRENCY=3

# MUST match the head's AUTH_TOKEN — the worker uses the first token as the
# bearer credential to pull a missing book PDF from the head (see FLEET_HEAD_URL).
AUTH_TOKEN=<same-token-as-the-head>

# Head's API base URL. When a job needs a book's source.pdf and it's not on this
# worker's local disk, the worker fetches it from here (R13), then caches it.
# No trailing slash. (Leave empty ONLY if VAR_DIR points at a volume the head
# and every worker both mount.)
FLEET_HEAD_URL=http://<HEAD-LAN-IP>:8000


# ─── VERTEX / GEMINI API CREDENTIALS (transport=api) ───────────────────
# Each worker PC uses ITS OWN service-account key in ITS OWN GCP project, so the
# fleet doesn't collide on a single project's Vertex quota (this is the fix for
# the rate-limit we hit running two boxes under one project).
#
# PREFERRED: use Fleet → Keys in the web UI to upload SA keys and assign them
# to worker hostnames. The worker downloads and applies the key automatically on
# startup/each loop tick — no manual file copy and no restart needed. When the
# worker applies a key it writes these two vars into its .env automatically; you
# don't need to set them here in that case.
# ⚠  AUTH_TOKEN must be a real, non-empty secret when using SA key distribution
# because the key-download endpoint is a credential vault (it rejects ?token= and
# 503s when auth is disabled — but a weak token is still a security hole).
#
# ALTERNATIVE (manual): copy the SA JSON onto this PC and set the path below.
GOOGLE_APPLICATION_CREDENTIALS=/path/on/this/pc/service-account.json
GOOGLE_CLOUD_PROJECT=<gcp-project-id-matching-the-key-above>
GOOGLE_CLOUD_LOCATION=global
# Alternatively (NOT for the Vertex fleet): a raw Gemini API key instead of a SA.
# Leave the three GOOGLE_* above blank if you use this.
# GEMINI_API_KEY=
# For transport=api claude jobs only (the fleet is all-gemini, so usually blank):
# ANTHROPIC_API_KEY=


# ─── NOTION ARCHIVE (runs on the worker at job completion) ─────────────
# Completed homeworks file into Notion from the worker that ran them. Best-effort:
# if blank, jobs still finish — they just aren't archived. Use the SAME values as
# the head so every worker archives into the same workspace.
NOTION_ENABLED=true
NOTION_API_KEY=<notion-integration-token>
# JSON map "{subject}|{grade}" -> Notion page-id (or a {keyword: page-id} object
# for split subjects like history). Add "ru:"/"en:" prefixed keys for non-Uzbek
# mediums. Paste the head's NOTION_SUBJECT_PAGES value verbatim.
NOTION_SUBJECT_PAGES={}


# ─── OPTIONAL — sane defaults, override only if you must ────────────────

# Process-wide cap on concurrent provider calls on THIS PC. With WORKER_CONCURRENCY
# jobs each fanning out parallel phases, this bounds total simultaneous Vertex
# calls so one box stays within quota. Default 8.
# AGENT_MAX_CONCURRENCY=8

# Local PDF cache dir (worker downloads from FLEET_HEAD_URL land here). Default ./var.
# VAR_DIR=var

# Hard wall-clock per job before timeout/retry (seconds). Default 1800.
# JOB_TIMEOUT_SECONDS=1800

# Empty-queue poll interval (seconds). Default 2.0.
# WORKER_POLL_INTERVAL=2.0

# Cost kill-switches (USD). Normally enforced by the head's budget monitor, not
# per worker; harmless to leave at 0/disabled here.
# COST_CAP_BATCH_USD=0
# COST_CAP_FLEET_DAILY_USD=0
