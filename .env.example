# ─── LLM PROVIDERS (CLI router) ───────────────────────────────────────
# Generation runs through CLI subprocesses (claude / kimi / codex / gemini /
# opencode on PATH) — the default `transport=cli` uses each CLI's OWN login
# (subscription / OAuth) and needs NO keys here.
#
# ─── TRANSPORT=API CREDENTIALS (Phase 4 toggle) ───────────────────────
# Only needed to run `transport=api` jobs (pay-per-token). A worker claims an
# api job only when BOTH sides are credentialed:
#   • claude side:  ANTHROPIC_API_KEY
#   • gemini side:  GEMINI_API_KEY (AI Studio, https://aistudio.google.com/apikey)
#                   OR a Vertex AI service account (fleet-api-6):
#                   GOOGLE_APPLICATION_CREDENTIALS + GOOGLE_CLOUD_PROJECT
#                   (explicit GEMINI_API_KEY wins when both are set)
#
# These are read from the PROCESS ENVIRONMENT (os.environ). Entries in this
# file reach os.environ everywhere: docker compose exports them via
# `env_file:`, and on bare metal the app loads .env at startup
# (config.py load_dotenv; a real exported variable always wins over .env).
# Also remove `security.auth.selectedType` from ~/.gemini/settings.json on
# the worker (a persisted interactive login overrides env-based auth and
# silently defeats the cli|api toggle — the worker warns at startup).
# ANTHROPIC_API_KEY=sk-ant-...
# GEMINI_API_KEY=AIza...
# GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/service-account.json
# GOOGLE_CLOUD_PROJECT=your-gcp-project-id
# GOOGLE_CLOUD_LOCATION=global   # default; regional endpoints may 404

# ─── DATABASE ─────────────────────────────────────────────────────────
# When running via docker-compose, DATABASE_URL is constructed from the
# POSTGRES_* values below — leave it commented unless you point at a
# managed Postgres (Neon, Supabase, RDS, etc.).
# DATABASE_URL=postgresql+asyncpg://user:pass@host:5432/dbname
POSTGRES_USER=edu
POSTGRES_PASSWORD=edu
POSTGRES_DB=edu_homework

# ─── IMAGE ────────────────────────────────────────────────────────────
# Override the published image tag (default: ghcr.io/ganiyevuz/class-homework-builder:latest).
# IMAGE=ghcr.io/ganiyevuz/class-homework-builder:sha-abc1234

# Model selection (judge/extract/TOC) now lives in the DB, edited at /settings — not here.

# ─── AUTH ──────────────────────────────────────────────────────────────
# Comma-separated list of valid bearer tokens. Empty disables auth (every
# request accepted as user="anonymous"). Set this BEFORE going live.
#   Single token:   AUTH_TOKEN=s3cr3t-token-from-our-platform
#   Multi-tenant:   AUTH_TOKEN=svc-a-token,svc-b-token,manual-paste-token
AUTH_TOKEN=

# ─── QUEUE / WORKER ────────────────────────────────────────────────────
# Embedded worker concurrency (jobs running simultaneously per process).
# Set to 0 in API-only pods when running standalone workers separately.
WORKER_CONCURRENCY=4
# Polling interval (seconds) when the queue is empty.
WORKER_POLL_INTERVAL=2.0
# Max wall-clock per job before timeout/retry. HARD biology runs ~60-90s.
JOB_TIMEOUT_SECONDS=600
# Max retry attempts before terminal failure.
QUEUE_MAX_ATTEMPTS=3
# Queue depth that triggers 503 backpressure on /generate. Set 0 to disable.
QUEUE_BACKPRESSURE_LIMIT=50

# ─── GEMINI CONCURRENCY ───────────────────────────────────────────────
# Process-wide cap on simultaneous Gemini calls. Prevents rate-limit
# cascades when worker concurrency × parallel scheduler fan-out exceeds
# your account's RPM. Tune this to your tier (free=15 RPM, paid varies).
GEMINI_MAX_CONCURRENCY=8

# ─── UPLOAD LIMIT ─────────────────────────────────────────────────────
MAX_FILE_MB=50

# ─── DEV CONVENIENCE ──────────────────────────────────────────────────
# Expose /docs (Swagger). Disable in production.
ENABLE_DOCS=false
# CORS allow-list. `*` allows any origin (fine when API + SPA same-origin
# via the embedded SPA mount; tighten in production multi-origin setups).
ALLOW_ORIGINS=*

# ─── AGENT USAGE LIMITS ───────────────────────────────────────────────
# Per-provider call-count caps, per rolling window. Drives the /usage
# dashboard percentages. The four CLIs (claude / kimi / codex / gemini)
# don't expose real quota APIs in headless mode, so the dashboard tracks
# LOCAL consumption — calls THIS app has issued — over fixed rolling
# windows (1h / 24h / 7d) and compares each against the matching cap.
# Set to 0 to disable the % readout for that window (renders as `—`).
# Match these to the plan/tier you're on for each provider.
AGENT_LIMIT_CLAUDE_1H=100
AGENT_LIMIT_CLAUDE_24H=1000
AGENT_LIMIT_CLAUDE_7D=5000

AGENT_LIMIT_KIMI_1H=60
AGENT_LIMIT_KIMI_24H=600
AGENT_LIMIT_KIMI_7D=3000

AGENT_LIMIT_CODEX_1H=60
AGENT_LIMIT_CODEX_24H=500
AGENT_LIMIT_CODEX_7D=2500

AGENT_LIMIT_GEMINI_1H=60
AGENT_LIMIT_GEMINI_24H=1500
AGENT_LIMIT_GEMINI_7D=10000

# Notion archive (Phase 1 push). Leave NOTION_ENABLED=false to no-op.
NOTION_ENABLED=false
NOTION_API_KEY=
# JSON: { "<subject>|<grade>": "<subject-page-id>" }
# Uzbek (default) uses the bare "<subject>|<grade>" key. For English/Russian
# medium, add a language-prefixed key so non-Uzbek content files under its OWN
# Notion page: { "ru:<subject>|<grade>": "<ru-page-id>", "en:<subject>|<grade>": "<en-page-id>" }.
# A non-uz job whose language key is absent is SKIPPED (with a recorded reason),
# never mis-filed into the Uzbek page.
NOTION_SUBJECT_PAGES={}
